# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Widget Preview related
.widget_preview/

# Firebase client configuration (kept local, never committed)
/lib/firebase_options.dart
/android/app/google-services.json
/ios/Runner/GoogleService-Info.plist
/android/app/src/dev/google-services.json
/android/app/src/prod/google-services.json
/ios/config/dev/GoogleService-Info.plist
/ios/config/prod/GoogleService-Info.plist
/firebase-debug.log
/functions/node_modules/
/.firebase/
/functions/.env
/functions/.env.*
/.local/
/.env
/.env.*
/content/*.lock
/content/*.tmp

# Sentry symbol-upload authentication stays on this computer/CI only.
/sentry.properties
/.sentryclirc
**/sentry.properties
**/.sentryclirc

# Fastlane credentials and generated release reports.
/.bundle/
/vendor/bundle/
/fastlane/report.xml
/fastlane/README.html
