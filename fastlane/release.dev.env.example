# Bu örneği .local/release.dev.env olarak kopyala. Gerçek değerleri buraya yazma.
# Yollar proje köküne göre veya mutlak olabilir. Boş alanları doldur.
ANDROID_KEYSTORE_PATH=.local/credentials/dev-upload.jks
ANDROID_KEYSTORE_PASSWORD=
ANDROID_KEY_ALIAS=upload
ANDROID_KEY_PASSWORD=
PLAY_JSON_KEY_PATH=.local/credentials/play-dev.json

# Team ID, App Store Connect Issuer ID ile aynı şey değildir.
APPLE_TEAM_ID=
ASC_KEY_ID=
ASC_ISSUER_ID=
ASC_KEY_PATH=.local/credentials/AuthKey_dev.p8

# Mevcut .local/sentry.dev.json yalnız SENTRY_DSN içermeli.
# Upload tokenı bu env dosyasında kalır; dart-define içine girmez.
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
