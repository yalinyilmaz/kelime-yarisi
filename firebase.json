{
  "hosting": {
    "site": "kelime-yarisi-yalin",
    "public": "hosting/invitations/public",
    "ignore": ["firebase.json", "**/node_modules/**", "**/.git/**", "**/.DS_Store", "**/.env*", "**/.local/**", "**/*.p8", "**/*.p12", "**/*.jks", "**/*.keystore", "**/*.mobileprovision"],
    "rewrites": [{"source": "/invite/**", "destination": "/index.html"}],
    "headers": [
      {"source": "/.well-known/**", "headers": [
        {"key": "Content-Type", "value": "application/json"},
        {"key": "Cache-Control", "value": "public,max-age=300"}
      ]},
      {"source": "**", "headers": [
        {"key": "X-Content-Type-Options", "value": "nosniff"},
        {"key": "Referrer-Policy", "value": "no-referrer"},
        {"key": "Content-Security-Policy", "value": "default-src 'self'; script-src 'self'; style-src 'self'; frame-ancestors 'none'; base-uri 'none'"},
        {"key": "Cache-Control", "value": "public,max-age=300"}
      ]}
    ]
  },
  "database": {
    "rules": "database.rules.json"
  },
  "functions": [{
    "source": "functions",
    "codebase": "question-pool",
    "ignore": ["node_modules", "test", "tools", "content/examples.json", ".env", ".env.*", "**/.env", "**/.env.*", ".local", "**/.local/**", ".secret.local", "**/.secret.local", "src/content_quality.js", "*.log", "sentry.properties", "**/sentry.properties", ".sentryclirc", "**/.sentryclirc"],
    "predeploy": ["node \"$RESOURCE_DIR/tools/check_deploy.js\""]
  }],
  "emulators": {
    "auth": {"port": 9099},
    "database": {"port": 9000},
    "functions": {"port": 5001},
    "ui": {"enabled": false},
    "singleProjectMode": true
  },
  "auth": {
    "providers": {
      "anonymous": true
    }
  }
}
