{
  "name": "kelime-yarisi-questions",
  "private": true,
  "type": "module",
  "main": "src/index.js",
  "engines": {
    "node": "22"
  },
  "scripts": {
    "test": "node --test test/*.test.js",
    "content": "node tools/content.js",
    "content:sources": "node tools/import_sources.js",
    "content:enrich": "node tools/enrich_sources.js",
    "content:replenish": "node tools/replenish.js",
    "content:quality": "node tools/quality.js",
