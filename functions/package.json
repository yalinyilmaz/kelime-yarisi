    "content:daily": "node tools/replenish.js --daily --ai-review",
    "content:queue": "node tools/build_queue.js",
    "check:deploy": "node tools/check_deploy.js",
    "test:emulator": "node --test test/emulator.integration.js"
  },
  "dependencies": {
    "firebase-admin": "^14.5.0",
    "firebase-functions": "^7.4.0"
  },
  "overrides": {"@grpc/grpc-js": "1.14.6"},
  "devDependencies": {
    "@firebase/rules-unit-testing": "^6.0.0",
    "firebase": "^13.0.0"
  }
}
